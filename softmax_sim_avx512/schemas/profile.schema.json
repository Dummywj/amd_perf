        "read_bytes_per_cycle",
        "write_bytes_per_cycle",
        "max_outstanding_misses",
        "shared_by_cores"
      ],
      "properties": {
        "size_bytes": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "ways": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "latency_cycles": {
          "$ref": "#/$defs/positive_number_or_measure"
        },
        "read_bytes_per_cycle": {
          "$ref": "#/$defs/positive_number_or_measure"
        },
        "write_bytes_per_cycle": {
