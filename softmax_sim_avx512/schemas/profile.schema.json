{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dummywj/amd_perf/blob/master/softmax_sim_avx512/schemas/profile.schema.json",
  "title": "Vector Inference Microarchitecture Profile",
  "description": "Cycle-level profile for straight-line vector kernels used in LLM inference. This MVP intentionally excludes masks, complex control flow, TLB and detailed prefetch state.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 5
          }
        },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["backend"]
      }
    }
  ],
  "required": [
    "schema_version",
    "profile_id",
    "profile_status",
    "cpu",
    "isa",
    "pipeline",
    "resources",
    "issue_domains",
    "recipes",
    "memory",
    "metadata",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [4, 5],
      "description": "Version 5 adds ISA-neutral vector and structural backend fields while retaining version 4 profiles."
    },
    "profile_id": {
      "$ref": "#/$defs/identifier"
    },
    "profile_status": {
      "type": "string",
      "enum": ["draft", "calibrated", "released"]
    },
    "description": {
      "type": "string"
    },
    "cpu": {
      "$ref": "#/$defs/cpu"
    },
    "isa": {
      "$ref": "#/$defs/isa"
    },
    "pipeline": {
      "$ref": "#/$defs/pipeline"
    },
    "resources": {
      "type": "object",
      "description": "Execution resources referenced by recipe uops.",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/execution_resource"
      }
    },
    "issue_domains": {
      "type": "object",
      "description": "Measured shared issue eligibility constraints layered on aggregate execution resources.",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/issue_domain"
      }
    },
    "backend": {
      "$ref": "#/$defs/backend"
    },
    "memory_compute_overlap_limit": {
      "$ref": "#/$defs/memory_compute_overlap_limit"
    },
    "recipes": {
      "type": "object",
      "description": "Mappings from canonical instruction forms to effective simulator uops. These uops need not equal undocumented physical uops.",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/instruction_recipe"
      }
    },
    "scalar_control_fit": {
      "$ref": "#/$defs/scalar_control_fit"
    },
    "memory": {
      "$ref": "#/$defs/memory"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "evidence": {
      "type": "array",
      "description": "Centralized provenance for known or estimated profile values.",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "number_or_measure": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "const": "measure"
        }
      ]
    },
    "positive_number_or_measure": {
      "oneOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "const": "measure"
        }
      ]
    },
    "positive_integer_or_measure": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "const": "measure"
        }
      ]
    },
    "nonnegative_integer_or_measure": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "const": "measure"
        }
      ]
    },
    "cpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "family", "model", "stepping", "microarchitecture"],
      "properties": {
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "stepping": {
          "type": "string",
          "minLength": 1
        },
        "microarchitecture": {
          "$ref": "#/$defs/identifier"
        },
        "configuration": {
          "type": "string",
          "minLength": 1
        },
        "core_count": {
          "type": "integer",
          "minimum": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 7
        },
        "product_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "isa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_features", "max_vector_bits"],
      "properties": {
        "architecture": {
          "$ref": "#/$defs/identifier"
        },
        "required_features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "zmm_registers": {
          "type": "integer",
          "minimum": 1
        },
        "logical_vector_registers": {
          "type": "integer",
          "minimum": 1
        },
        "physical_vector_registers": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "max_vector_bits": {
          "type": "integer",
          "minimum": 1
        },
        "vector_length_bits": {
          "type": "integer",
          "minimum": 1
        },
        "max_element_bits": {
          "type": "integer",
          "minimum": 1
        },
        "vector_length_policy": {
          "type": "string",
          "enum": ["fixed", "runtime-vl"]
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatch_macro_ops_per_cycle",
        "retire_macro_ops_per_cycle",
        "rob_entries",
        "vector_scheduler_entries",
        "load_queue_entries",
        "store_queue_entries"
      ],
      "properties": {
        "dispatch_macro_ops_per_cycle": {
          "description": "Dispatch bandwidth in the units selected by backend.macro_op_accounting.dispatch_units; legacy profiles count decoded macro-ops.",
          "$ref": "#/$defs/positive_number_or_measure"
        },
        "retire_macro_ops_per_cycle": {
          "$ref": "#/$defs/positive_number_or_measure"
        },
        "rob_entries": {
          "description": "ROB capacity in the units selected by backend.macro_op_accounting.rob_entries; legacy profiles count decoded macro-ops.",
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "vector_scheduler_entries": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "load_queue_entries": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "store_queue_entries": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "fetch_instructions_per_cycle": {
          "$ref": "#/$defs/positive_number_or_measure"
        },
        "decode_instructions_per_cycle": {
          "$ref": "#/$defs/positive_number_or_measure"
        },
        "rename_instructions_per_cycle": {
          "$ref": "#/$defs/positive_number_or_measure"
        },
        "vector_type_buffer_entries": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "rename_allocation_buffer_entries": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "vector_memory_queue_entries": {
          "$ref": "#/$defs/positive_integer_or_measure"
        }
      }
    },
    "resource_kind": {
      "type": "string",
      "enum": [
        "vector_fp",
        "vector_integer",
        "conversion",
        "shuffle",
        "vector_control",
        "vector_divide",
        "address_generation",
        "load_data",
        "store_data"
      ]
    },
    "execution_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "capacity"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/resource_kind"
        },
        "capacity": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "width_bits": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "bytes_per_cycle": {
          "$ref": "#/$defs/positive_number_or_measure"
        },
        "source_latency_cycles": {
          "description": "Latency declared by the source FU block. This is provenance, not necessarily end-to-end dependency latency used by a recipe.",
          "$ref": "#/$defs/number_or_measure"
        },
        "pipelined": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "backend": {
      "type": "object",
      "description": "Structural topology consumed by the named microarchitecture backend. Semantic uops are shared, but backend-uop expansion and scheduling may differ by execution_model.",
      "additionalProperties": false,
      "required": [
        "execution_model",
        "scheduler_partitions",
        "execution_units",
        "register_files",
        "vector_memory"
      ],
      "properties": {
        "execution_model": {
          "$ref": "#/$defs/identifier"
        },
        "macro_op_accounting": {
          "$ref": "#/$defs/macro_op_accounting"
        },
        "dispatch_domains": {
          "type": "object",
          "description": "Frontend macro-op admission domains. Each dispatched macro consumes one token per listed domain unless a recipe demand override is provided; capacities reset at each architectural dispatch cycle.",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/dispatch_domain"
          }
        },
        "scheduler_partitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scheduler_partition"
          }
        },
        "execution_units": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/execution_unit"
          }
        },
        "register_files": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/register_file"
          }
        },
        "vector_memory": {
          "$ref": "#/$defs/vector_memory_backend"
        },
        "rename": {
          "$ref": "#/$defs/rename_backend"
        },
        "vector_dependency": {
          "$ref": "#/$defs/vector_dependency_policy"
        },
        "xsai_rvv": {
          "$ref": "#/$defs/xsai_rvv_backend_policy"
        },
        "vector_decomposition": {
          "$ref": "#/$defs/vector_decomposition_backend"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "macro_op_accounting": {
      "type": "object",
      "description": "Profile-driven mapping from a bound architectural instruction to independent dispatch-bandwidth and ROB-capacity units. If omitted, both retain the legacy decoded_macro_ops basis.",
      "additionalProperties": false,
      "required": ["dispatch_units", "rob_entries"],
      "properties": {
        "dispatch_units": {
          "$ref": "#/$defs/macro_op_accounting_basis"
        },
        "rob_entries": {
          "$ref": "#/$defs/macro_op_accounting_basis"
        }
      }
    },
    "macro_op_accounting_basis": {
      "type": "string",
      "enum": [
        "decoded_macro_ops",
        "execution_uops",
        "max_decoded_or_execution_uops",
        "architectural_instructions"
      ]
    },
    "dispatch_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity", "evidence"],
      "properties": {
        "capacity": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "scheduler_partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "entries", "enqueue_width", "execution_units"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "type": "string",
          "enum": ["scalar", "vector_compute", "vector_memory", "matrix"]
        },
        "entries": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "enqueue_width": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "execution_units": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "execution_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheduler_partition", "functional_units"],
      "properties": {
        "scheduler_partition": {
          "$ref": "#/$defs/identifier"
        },
        "functional_units": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "vector_read_domain": {
          "$ref": "#/$defs/identifier"
        },
        "vector_writeback_domain": {
          "$ref": "#/$defs/identifier"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "register_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_registers",
        "physical_registers",
        "width_bits",
        "read_ports",
        "writeback_ports"
      ],
      "properties": {
        "logical_registers": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "physical_registers": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "width_bits": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "read_ports": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "writeback_ports": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "read_domains": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/register_port_domain"
          }
        },
        "writeback_domains": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/register_port_domain"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "register_port_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port_count", "arbitration_capacity", "execution_units"],
      "properties": {
        "port_count": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "arbitration_capacity": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "execution_units": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "vector_memory_backend": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "boundary_bytes": ["issue_cycles_per_flow"],
        "issue_cycles_per_flow": ["boundary_bytes"]
      },
      "required": [
        "load_pipelines",
        "store_pipelines",
        "source_input_width",
        "instruction_writeback_width",
        "max_unit_stride_flows",
        "load_merge_buffer_entries",
        "store_merge_buffer_entries"
      ],
      "properties": {
        "declared_vls_queue_entries": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "declared_vls_queue_connected": {
          "type": "boolean"
        },
        "load_pipelines": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "store_pipelines": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "source_input_width": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "instruction_writeback_width": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "max_unit_stride_flows": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "load_merge_buffer_entries": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "store_merge_buffer_entries": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "issue_order": {
          "type": "string",
          "enum": ["any", "oldest", "oldest_same_kind"]
        },
        "service_capacity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "load": {
              "$ref": "#/$defs/positive_integer_or_measure"
            },
            "store": {
              "$ref": "#/$defs/positive_integer_or_measure"
            }
          },
          "minProperties": 1,
          "description": "Maximum vector-memory accesses occupying downstream service independently for load and store. This is distinct from address-level internal flow splitting."
        },
        "store_completion_cycles": {
          "$ref": "#/$defs/number_or_measure"
        },
        "service_cycles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "load": {
              "$ref": "#/$defs/number_or_measure"
            },
            "store": {
              "$ref": "#/$defs/number_or_measure"
            }
          },
          "minProperties": 1
        },
        "boundary_bytes": {
          "$ref": "#/$defs/positive_integer_or_measure",
          "description": "Address boundary used to split one vector memory access into internal flows. This policy is inert when the split-policy fields are omitted."
        },
        "issue_cycles_per_flow": {
          "$ref": "#/$defs/number_or_measure",
          "description": "Load/store aggregate split-lane issue occupancy contributed by each internal flow. The flow count is capped by max_unit_stride_flows."
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "xsai_rvv_backend_policy": {
      "type": "object",
      "description": "Policies consumed only by the independent XSAI-RVV execution backend.",
      "additionalProperties": false,
      "required": ["vector_epochs"],
      "properties": {
        "vector_epochs": {
          "$ref": "#/$defs/xsai_vector_epoch_policy"
        }
      }
    },
    "xsai_vector_epoch_policy": {
      "type": "object",
      "description": "Effective XSAI VL/VTYPE epoch visibility and completion rules. Conditions are expressed by semantic dataflow topology rather than kernel or mnemonic names.",
      "additionalProperties": false,
      "required": [
        "enabled",
        "load_only_visibility_cycles",
        "multi_load_drain_cycles",
        "chained_compute_drain_cycles",
        "parallel_reduction_overlap_cycles",
        "mixed_store_reduction_capacity",
        "evidence"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "load_only_visibility_cycles": {
          "$ref": "#/$defs/number_or_measure",
          "description": "Additional VL-state visibility time for loads in an epoch that has no computed store or reduction terminal."
        },
        "multi_load_drain_cycles": {
          "$ref": "#/$defs/number_or_measure",
          "description": "Effective post-store drain for an epoch whose computed store depends on at least two architectural vector loads."
        },
        "chained_compute_drain_cycles": {
          "$ref": "#/$defs/number_or_measure",
          "description": "Effective post-store drain for an epoch whose computed store depends on at least two architectural vector-compute operations and fewer than two vector loads."
        },
        "parallel_reduction_overlap_cycles": {
          "$ref": "#/$defs/number_or_measure",
          "description": "Overlap allowed before the final completion of an epoch containing multiple independent reductions."
        },
        "mixed_store_reduction_capacity": {
          "$ref": "#/$defs/positive_integer_or_measure",
          "description": "Maximum mixed computed-store plus reduction epochs admitted before a terminal result completes."
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "rename_backend": {
      "type": "object",
      "description": "Optional profile-driven physical-register rename/free-list model. Omitted profiles retain the legacy behavior.",
      "additionalProperties": false,
      "required": [
        "enabled",
        "free_lists",
        "allocation_width",
        "release_width",
        "release_delay_cycles",
        "availability_delay_cycles",
        "guard_entries",
        "policy"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "free_lists": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/rename_free_list"
          }
        },
        "allocation_width": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "release_width": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "release_delay_cycles": {
          "$ref": "#/$defs/number_or_measure"
        },
        "availability_delay_cycles": {
          "$ref": "#/$defs/number_or_measure"
        },
        "guard_entries": {
          "$ref": "#/$defs/nonnegative_integer_or_measure"
        },
        "policy": {
          "type": "string",
          "enum": ["all_files_must_be_ready", "any_file_may_be_ready"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "rename_free_list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["free_entries"],
      "properties": {
        "free_entries": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "vector_dependency_policy": {
      "type": "object",
      "description": "Optional semantic vector readiness rules applied by backends that support them; omitted policies preserve legacy behavior.",
      "additionalProperties": false,
      "required": ["evidence"],
      "anyOf": [
        {"required": ["vector_state"]},
        {"required": ["old_destination"]}
      ],
      "properties": {
        "vector_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["registers", "wait_execution_kinds"],
          "properties": {
            "registers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            },
            "wait_execution_kinds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/resource_kind"
              }
            }
          }
        },
        "old_destination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "wait_execution_kinds"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["disabled", "semantic"]
            },
            "wait_execution_kinds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/resource_kind"
              }
            },
            "implicit_execution_kinds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "description": "Execution kinds for which the implementation retains the previous vector destination as a RAW source even when the ISA operands do not explicitly read vd.",
              "items": {
                "$ref": "#/$defs/resource_kind"
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "vector_decomposition_backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["register_width_bits", "rules"],
      "properties": {
        "register_width_bits": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "rules": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/decomposition_rule"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "decomposition_rule": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "enum": ["lmul", "dynamic", "measure"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["parts", "prep_uops"],
          "properties": {
            "parts": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "string",
                  "enum": ["lmul", "dynamic", "measure"]
                }
              ]
            },
            "prep_uops": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "enum": ["register", "immediate", "fp_register", "default"]
              },
              "additionalProperties": {
                "$ref": "#/$defs/uop"
              }
            }
          }
        }
      ]
    },
    "issue_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity", "evidence"],
      "properties": {
        "capacity": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "memory_compute_overlap_limit": {
      "type": "object",
      "description": "ISA-neutral limit on concurrently pending load-to-compute groups. A group is discovered from execution-uop dependencies within one macro-op, not from an instruction mnemonic.",
      "additionalProperties": false,
      "required": ["enabled", "max_pending_groups", "compute_semantic_kinds"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_pending_groups": {
          "type": "integer",
          "minimum": 1
        },
        "compute_semantic_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "instruction_recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_features",
        "decoded_macro_ops",
        "retire_macro_ops",
        "uops"
      ],
      "properties": {
        "required_features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "decoded_macro_ops": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "retire_macro_ops": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "dispatch_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "dispatch_domain_demands": {
          "type": "object",
          "description": "Optional per-domain macro token demand. Listed dispatch domains default to one token.",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "vector_decomposition": {
          "$ref": "#/$defs/vector_decomposition"
        },
        "rename_allocations": {
          "$ref": "#/$defs/rename_allocations"
        },
        "uops": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/uop"
          }
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "vector_decomposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parts", "part_width_bits", "part_issue_gap_cycles"],
      "properties": {
        "parts": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "part_width_bits": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "part_issue_gap_cycles": {
          "$ref": "#/$defs/number_or_measure"
        },
        "scale_issue_interval_by_parts": {
          "type": "boolean",
          "description": "When false, each decomposed part stream keeps the uop issue interval instead of multiplying it by the part count. Defaults to true."
        }
      }
    },
    "uop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "latency_cycles",
        "issue_interval_cycles",
        "resource_choices",
        "resource_occupancy_cycles"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "$ref": "#/$defs/resource_kind"
        },
        "latency_cycles": {
          "$ref": "#/$defs/number_or_measure"
        },
        "issue_interval_cycles": {
          "$ref": "#/$defs/positive_number_or_measure"
        },
        "resource_choices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "resource_occupancy_cycles": {
          "$ref": "#/$defs/positive_number_or_measure"
        },
        "issue_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "issue_domain_demands": {
          "type": "object",
          "description": "Per-uop token demand overrides. Listed issue domains default to one token when omitted.",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "rename_allocations": {
          "$ref": "#/$defs/rename_allocations"
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "part_index": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "rename_allocations": {
      "type": "object",
      "description": "Physical rename free-list entries allocated by an instruction or one execution uop. Values are entry counts.",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "scalar_control_fit": {
      "type": "object",
      "description": "Microarchitecture-specific fallback timing for scalar and control semantic uops without an instruction recipe.",
      "additionalProperties": false,
      "required": ["enabled", "resources", "uops", "evidence"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "resources": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/scalar_control_resource"
          }
        },
        "uops": {
          "type": "object",
          "required": [
            "scalar_alu",
            "scalar_fp_add",
            "scalar_fp_div",
            "scalar_move",
            "branch",
            "return"
          ],
          "additionalProperties": false,
          "properties": {
            "scalar_alu": {"$ref": "#/$defs/scalar_control_uop"},
            "scalar_fp_add": {"$ref": "#/$defs/scalar_control_uop"},
            "scalar_fp_div": {"$ref": "#/$defs/scalar_control_uop"},
            "scalar_move": {"$ref": "#/$defs/scalar_control_uop"},
            "branch": {"$ref": "#/$defs/scalar_control_uop"},
            "return": {"$ref": "#/$defs/scalar_control_uop"}
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "scalar_control_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity"],
      "properties": {
        "capacity": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "scalar_control_uop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latency_cycles",
        "issue_interval_cycles",
        "resource_occupancy_cycles",
        "resource_choices"
      ],
      "properties": {
        "latency_cycles": {
          "$ref": "#/$defs/number_or_measure"
        },
        "issue_interval_cycles": {
          "$ref": "#/$defs/positive_number_or_measure"
        },
        "resource_occupancy_cycles": {
          "$ref": "#/$defs/positive_number_or_measure"
        },
        "resource_choices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cache_line_bytes", "levels", "dram"],
