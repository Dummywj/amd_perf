        "latency_cycles",
        "read_bytes_per_cycle",
        "write_bytes_per_cycle",
        "max_outstanding_requests"
      ],
      "properties": {
        "latency_cycles": {
          "$ref": "#/$defs/positive_number_or_measure"
        },
        "read_bytes_per_cycle": {
          "$ref": "#/$defs/positive_number_or_measure"
        },
        "write_bytes_per_cycle": {
          "$ref": "#/$defs/positive_number_or_measure"
        },
        "max_outstanding_requests": {
          "$ref": "#/$defs/positive_integer_or_measure"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "simulator_min_version", "sources"],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_calibrated_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "simulator_min_version": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "accessed_on"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "type": "string",
          "enum": [
            "vendor_document",
            "research_paper",
            "source_code",
            "generated_configuration",
            "measurement",
            "assumption"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "format": "uri-reference"
        },
        "accessed_on": {
          "type": "string",
          "format": "date"
        },
        "command": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "minLength": 7
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "sources", "confidence"],
      "properties": {
        "parameter": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
